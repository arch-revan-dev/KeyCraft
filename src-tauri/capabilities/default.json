{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal offline capability for KeyCraft settings and screenshot overlay windows.",
  "windows": ["settings", "screenshot-overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus"
  ]
}
